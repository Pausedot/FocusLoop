<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_fixed"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/skipText"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_md"
        android:text="@string/five_skip"
        android:textColor="@color/white_fixed"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/readyLabel"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.55"
        android:text="@string/five_ready"
        android:textColor="@color/white_fixed"
        app:layout_constraintBottom_toTopOf="@id/countText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="-0.06"
        android:text="@string/five_count"
        android:textColor="@color/white_fixed"
        android:textSize="200sp"
        app:layout_constraintBottom_toTopOf="@id/fiveTaskName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/readyLabel"
        tools:ignore="SpUsage" />

    <TextView
        android:id="@+id/fiveTaskName"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:alpha="0.8"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/five_task_fallback"
        android:textColor="@color/white_fixed"
        app:layout_constraintBottom_toTopOf="@id/fiveDots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/countText" />

    <LinearLayout
        android:id="@+id/fiveDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/fiveHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fiveTaskName">

        <View
            android:id="@+id/dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_fixed_accent" />

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_dot_dim" />

        <View
            android:id="@+id/dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_dot_dim" />

        <View
            android:id="@+id/dot4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_dot_dim" />

        <View
            android:id="@+id/dot5"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_dot_dim" />
    </LinearLayout>

    <TextView
        android:id="@+id/fiveHint"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:alpha="0.55"
        android:text="@string/five_hint"
        android:textColor="@color/white_fixed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/doneIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_soft"
        android:contentDescription="@null"
        android:padding="7dp"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/doneTitle"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_sm"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/doneRestore"
        app:layout_constraintStart_toEndOf="@id/doneIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Redesign the case study layout" />

    <TextView
        android:id="@+id/doneMeta"
        style="@style/Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toStartOf="@id/doneRestore"
        app:layout_constraintStart_toStartOf="@id/doneTitle"
        app:layout_constraintTop_toBottomOf="@id/doneTitle"
        tools:text="A · Q1 · 50 min focused" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doneRestore"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:contentDescription="@string/cd_restore_task"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/done_restore"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/doneDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/doneIcon"
        app:layout_constraintTop_toBottomOf="@id/doneMeta" />

</androidx.constraintlayout.widget.ConstraintLayout>

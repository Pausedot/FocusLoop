<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FocusLoop.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/title_matrix"
        app:titleTextAppearance="@style/Text.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/frogCard"
                style="@style/Widget.FocusLoop.Card.Ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/frogLabel"
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/main_frog_label"
                        android:textColor="@color/white_fixed"
                        app:layout_constraintEnd_toStartOf="@id/frogMeta"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/frogMeta"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textColor="@color/white_fixed"
                        app:layout_constraintBaseline_toBaselineOf="@id/frogLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/frogTitle"
                        style="@style/Text.H2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textColor="@color/white_fixed"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/frogLabel"
                        tools:text="Redesign the case study layout" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Q1 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLoop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/q1Badge"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_badge_a"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/priority_a"
                            android:textColor="@color/accent"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/q1Title"
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/matrix_q1" />

                        <TextView
                            android:id="@+id/q1Count"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2 tasks" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/q1Task1"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Redesign the case study layout" />

                    <TextView
                        android:id="@+id/q1Task2"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Reply to the client about scope" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Q2 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLoop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/q2Badge"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_badge_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/priority_b"
                            android:textColor="@color/ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/q2Title"
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/matrix_q2" />

                        <TextView
                            android:id="@+id/q2Count"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2 tasks" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/q2Task1"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Outline the A2 database schema" />

                    <TextView
                        android:id="@+id/q2Task2"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Read chapter 7 on notifications" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Q3 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLoop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/q3Badge"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_badge_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/priority_c"
                            android:textColor="@color/ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/q3Title"
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/matrix_q3" />

                        <TextView
                            android:id="@+id/q3Count"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1 task" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/q3Task1"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Book the dentist" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Q4 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLoop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/q4Badge"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_badge_muted"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/priority_d"
                            android:textColor="@color/ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/q4Title"
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/matrix_q4" />

                        <TextView
                            android:id="@+id/q4Count"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="3 tasks" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/q4Task1"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Clean up Figma components" />

                    <TextView
                        android:id="@+id/q4Task2"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:visibility="gone"
                        tools:text="Plan the weekend trip" />

                    <TextView
                        android:id="@+id/q4More"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/matrix_more"
                        android:textColor="@color/accent"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

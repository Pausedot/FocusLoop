<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Type scale: 30 / 20 / 15 / 11 label / 12 caption. -->
    <style name="Text.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.H1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Text.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.BodyMuted" parent="Text.Body">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Toolbar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Number" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">sans-serif-monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Buttons: pill, 52dp, no shadow. -->
    <style name="Widget.FocusLoop.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.FocusLoop.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="Widget.FocusLoop.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">?attr/colorSurfaceVariant</item>
    </style>

    <!-- Flat card with a hairline, never a shadow. -->
    <style name="Widget.FocusLoop.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="rippleColor">?attr/colorSurfaceVariant</item>
    </style>


    <style name="Widget.FocusLoop.Card.Ink" parent="Widget.FocusLoop.Card">
        <item name="cardBackgroundColor">@color/ink_card</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/white_fixed</item>
    </style>

    <style name="Widget.FocusLoop.Card.AccentSoft" parent="Widget.FocusLoop.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Inputs. -->
    <style name="Widget.FocusLoop.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.FocusLoop.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.FocusLoop.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
    </style>

    <style name="Widget.FocusLoop.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/accent</item>
        <item name="trackColorInactive">@color/hairline</item>
        <item name="thumbColor">@color/accent</item>
        <item name="haloColor">@color/accent_soft</item>
        <item name="trackHeight">3dp</item>
        <item name="thumbRadius">9dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="labelBehavior">gone</item>
    </style>

    <style name="Widget.FocusLoop.Progress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
    </style>

    <style name="Widget.FocusLoop.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Text.Toolbar</item>
    </style>

</resources>
